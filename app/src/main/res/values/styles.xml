<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VirtualClicker" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/vc_primary</item>
        <item name="colorAccent">@color/vc_primary</item>
        <item name="colorControlActivated">@color/vc_primary</item>
        <item name="android:windowBackground">@color/vc_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/vc_bg</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/vc_bg</item>
        <item name="buttonStyle">@style/Widget.VC.Button</item>
        <item name="editTextStyle">@style/VC.Edit</item>
    </style>

    <style name="Theme.VirtualClicker.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/vc_primary</item>
        <item name="colorAccent">@color/vc_primary</item>
        <item name="colorControlActivated">@color/vc_primary</item>
        <item name="colorControlNormal">@color/vc_text2</item>
        <item name="colorButtonNormal">@color/vc_tonal</item>
        <item name="android:windowBackground">@color/vc_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/vc_bg</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/vc_bg</item>
        <item name="buttonStyle">@style/Widget.VC.Button</item>
        <item name="editTextStyle">@style/VC.Edit</item>
    </style>

    <style name="Widget.VC.Button" parent="Widget.AppCompat.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.VC.Button.Filled" parent="Widget.VC.Button">
        <item name="android:background">@drawable/bg_btn_filled</item>
        <item name="android:textColor">@color/vc_on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.VC.Button.Tonal" parent="Widget.VC.Button">
        <item name="android:background">@drawable/bg_btn_tonal</item>
        <item name="android:textColor">@color/vc_on_tonal</item>
    </style>

    <style name="VC.Section" parent="android:Widget.TextView">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/vc_text</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="VC.Body" parent="android:Widget.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/vc_text</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="VC.Caption" parent="android:Widget.TextView">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/vc_text2</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="VC.Edit" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/vc_text</item>
        <item name="android:textColorHint">@color/vc_text2</item>
        <item name="android:background">@drawable/bg_text_field</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>

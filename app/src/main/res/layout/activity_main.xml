<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VirtualClicker"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="通用后台自动点击器 · Shizuku 优先"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/shizukuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Shizuku：检查中…"
            android:textSize="17sp" />

        <Button
            android:id="@+id/shizukuPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="请求 Shizuku 授权" />

        <Button
            android:id="@+id/bindBackend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="连接 Shizuku 后端" />

        <TextView
            android:id="@+id/backendStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="后台后端：未连接"
            android:textSize="16sp" />

        <Button
            android:id="@+id/listApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="查看可添加应用" />

        <TextView
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="14sp" />

        <TextView
            android:id="@+id/launchVirtualDisplayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="虚拟屏预览"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_preview_container"
            android:clipToOutline="true"
            android:clipChildren="true">

            <SurfaceView
                android:id="@+id/virtualDisplaySurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/previewPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="待执行"
                android:textColor="#5F6368"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_status_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_idle" />

                <TextView
                    android:id="@+id/statusBadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="待机"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/fullscreenCloseButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_status_badge"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/resolutionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="虚拟屏分辨率"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/resolutionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:spinnerMode="dropdown" />

        <TextView
            android:id="@+id/manualControlHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="双击预览：放大/缩小（放大后点右上角 ✕ 缩回，游戏不会关闭）；长按：应用内手动控制"
            android:textSize="12sp"
            android:textColor="#5F6368" />

        <LinearLayout
            android:id="@+id/launchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/launchVirtualDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="启动到虚拟屏" />

            <Button
                android:id="@+id/closeVirtualDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="关闭虚拟屏" />
        </LinearLayout>

        <TextView
            android:id="@+id/virtualDisplayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="14sp" />

        <TextView
            android:id="@+id/inputTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="虚拟屏输入测试"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inputHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="输入坐标会发送到当前 Virtual Display，不会点击手机主屏。"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputX"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="X"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/inputY"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="Y"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/inputDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="长按(ms)"
                android:inputType="number" />
        </LinearLayout>


        <TextView
            android:id="@+id/autoClickTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="连点器"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/autoClickHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="使用上面的 X/Y 作为点击坐标；间隔为两次点击之间的等待时间；次数填 0 表示无限点击。"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/autoClickRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/autoClickInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="间隔(ms)"
                android:inputType="number"
                android:text="500" />

            <EditText
                android:id="@+id/autoClickCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="次数(0=无限)"
                android:inputType="number"
                android:text="0" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/autoClickButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startAutoClick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开始连点" />

            <Button
                android:id="@+id/stopAutoClick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="停止连点" />
        </LinearLayout>

        <TextView
            android:id="@+id/autoClickStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="连点器：未运行"
            android:textSize="14sp" />

        <Button
            android:id="@+id/testTap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="测试点击" />

        <Button
            android:id="@+id/testLongPress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="测试长按" />

        <Button
            android:id="@+id/releaseVirtualDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="释放当前虚拟屏" />

        <TextView
            android:id="@+id/inputTestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="14sp" />

        <TextView
            android:id="@+id/roadmap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="V0.1 开发目标：Shizuku → UserService → Virtual Display → Display 定向输入 → 任务引擎"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>

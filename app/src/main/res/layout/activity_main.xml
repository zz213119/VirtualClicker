<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vc_bg"
    android:theme="@style/ThemeOverlay.AppCompat.Light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VirtualClicker"
            android:textColor="@color/vc_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/VC.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="通用后台自动点击器 · Shizuku 优先" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            android:id="@+id/shizukuStatus"
            style="@style/VC.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shizuku：检查中…" />
        <TextView
            android:id="@+id/backendStatus"
            style="@style/VC.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="后台后端：未连接" />
        <LinearLayout
            android:id="@+id/connectRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
        <Button
            android:id="@+id/shizukuPermission"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="请求授权" />
        <Button
            android:id="@+id/bindBackend"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="连接后端" />
        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            android:id="@+id/launchVirtualDisplayLabel"
            style="@style/VC.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="虚拟屏" />
        <com.zz213119.virtualclicker.ui.AspectRatioFrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="240dp"
            android:layout_height="426dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_preview_container"
            android:clipToOutline="true"
            android:clipChildren="true">

            <SurfaceView
                android:id="@+id/virtualDisplaySurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.zz213119.virtualclicker.ui.ScriptTrajectoryView
                android:id="@+id/scriptTrajectoryView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/previewPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="待执行"
                android:textColor="#5F6368"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/fullscreenCloseButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_status_badge"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_status_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_idle" />

                <TextView
                    android:id="@+id/statusBadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="待机"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

        </com.zz213119.virtualclicker.ui.AspectRatioFrameLayout>
        <TextView
            android:id="@+id/resolutionLabel"
            style="@style/VC.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="分辨率" />
        <Spinner
            android:id="@+id/resolutionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:spinnerMode="dropdown" />
        <TextView
            android:id="@+id/resolutionInfo"
            style="@style/VC.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="当前：自动竖屏" />
        <Button
            android:id="@+id/displayModeButton"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="游戏模式：关闭（自动比例）" />
        <TextView
            android:id="@+id/manualControlHint"
            style="@style/VC.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="双击预览画面：进入本人手动控制；点左上角 ✕ 结束控制（不会关闭虚拟屏）" />
        <LinearLayout
            android:id="@+id/launchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
        <Button
            android:id="@+id/launchVirtualDisplay"
            style="@style/Widget.VC.Button.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="启动到虚拟屏" />
        <Button
            android:id="@+id/closeVirtualDisplay"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="关闭虚拟屏" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/maintRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
        <Button
            android:id="@+id/relaunchGame"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="重启游戏" />
        <Button
            android:id="@+id/resetBackend"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="重置后台服务" />
        </LinearLayout>
        <TextView
            android:id="@+id/virtualDisplayStatus"
            style="@style/VC.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            android:id="@+id/yihuanTitle"
            style="@style/VC.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="异环 · 店长特供 1-1" />
        <TextView
            android:id="@+id/yihuanHelp"
            style="@style/VC.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="循环：选 1-1 → 开始营业 → 点锤子 → 退出 → 领取；体力耗尽时发通知。请先在上面启动虚拟屏。" />
        <Button
            android:id="@+id/runYihuanShopTask"
            style="@style/Widget.VC.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="开始自动刷" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            android:id="@+id/appsTitle"
            style="@style/VC.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="应用与脚本" />
        <Button
            android:id="@+id/listApps"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="选择要放进虚拟屏的应用" />
        <TextView
            android:id="@+id/appList"
            style="@style/VC.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="" />
        <Button
            android:id="@+id/openScriptEditor"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="脚本编辑器（自动精灵模式）" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            android:id="@+id/inputTitle"
            style="@style/VC.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="调试工具 · 输入测试" />
        <TextView
            android:id="@+id/inputHelp"
            style="@style/VC.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="输入坐标会发送到当前虚拟屏，不会点击手机主屏。" />
        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/inputX"
                style="@style/VC.Edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="X"
                android:inputType="numberDecimal" />
            <EditText
                android:id="@+id/inputY"
                style="@style/VC.Edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="Y"
                android:inputType="numberDecimal" />
            <EditText
                android:id="@+id/inputDuration"
                style="@style/VC.Edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="长按(ms)"
                android:inputType="number" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/testRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
        <Button
            android:id="@+id/testTap"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="测试点击" />
        <Button
            android:id="@+id/testLongPress"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="测试长按" />
        </LinearLayout>
        <Button
            android:id="@+id/pickCoordinate"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="取点坐标（点击预览获取 X/Y）" />
        <TextView
            android:id="@+id/pickCoordinateStatus"
            style="@style/VC.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="取点模式：未开启" />
        <TextView
            android:id="@+id/autoClickTitle"
            style="@style/VC.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="连点器" />
        <TextView
            android:id="@+id/autoClickHelp"
            style="@style/VC.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="使用上面的 X/Y 作为点击坐标；间隔为两次点击之间的等待时间；次数填 0 表示无限点击。" />
        <LinearLayout
            android:id="@+id/autoClickRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/autoClickInterval"
                style="@style/VC.Edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="间隔(ms)"
                android:inputType="number"
                android:text="500" />
            <EditText
                android:id="@+id/autoClickCount"
                style="@style/VC.Edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="次数(0=无限)"
                android:inputType="number"
                android:text="0" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/autoClickButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
        <Button
            android:id="@+id/startAutoClick"
            style="@style/Widget.VC.Button.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="开始连点" />
        <Button
            android:id="@+id/stopAutoClick"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="停止连点" />
        </LinearLayout>
        <TextView
            android:id="@+id/autoClickStatus"
            style="@style/VC.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="连点器：未运行" />
        <Button
            android:id="@+id/releaseVirtualDisplay"
            style="@style/Widget.VC.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="释放当前虚拟屏" />
        <TextView
            android:id="@+id/inputTestStatus"
            style="@style/VC.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="" />

        </LinearLayout>

        <TextView
            android:id="@+id/roadmap"
            style="@style/VC.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="V0.1 开发目标：Shizuku → UserService → Virtual Display → Display 定向输入 → 任务引擎"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>

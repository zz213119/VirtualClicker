<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top">

    <FrameLayout
        android:id="@+id/floatingCard"
        android:layout_width="160dp"
        android:layout_height="284dp"
        android:background="@drawable/bg_floating_card"
        android:clipToOutline="true"
        android:clipChildren="true">

        <SurfaceView
            android:id="@+id/floatingSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/floatingPackageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#66000000"
            android:padding="6dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:background="@drawable/bg_floating_toolbar"
        android:paddingVertical="6dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/btnPlayPause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="▶"
            android:textSize="16sp"
            android:textColor="#1A1A1A" />

        <TextView
            android:id="@+id/btnZoomIn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="＋"
            android:textSize="18sp"
            android:textColor="#1A1A1A" />

        <TextView
            android:id="@+id/btnZoomOut"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="－"
            android:textSize="18sp"
            android:textColor="#1A1A1A" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⚙"
            android:textSize="18sp"
            android:textColor="#1A1A1A" />

        <TextView
            android:id="@+id/btnHide"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="👁"
            android:textSize="16sp"
            android:textColor="#1A1A1A" />

        <TextView
            android:id="@+id/btnDrag"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="✥"
            android:textSize="16sp"
            android:textColor="#1A1A1A" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="16sp"
            android:textColor="#D93025" />
    </LinearLayout>

</LinearLayout>
